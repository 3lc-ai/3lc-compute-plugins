[
  {
    "name": "inspect_incoming",
    "title": "Inspect incoming data",
    "description": "Read a table's modality, exact class IDs, image and annotation columns, and row count. No AI or writes.",
    "input_schema": {
      "type": "object",
      "properties": {
        "table_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "table_url"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "route": {
      "method": "GET",
      "path": "/intake/inspect",
      "query": [
        "table_url"
      ]
    }
  },
  {
    "name": "intake_prepare",
    "title": "Check and prepare an incoming batch",
    "description": "Check sample/group overlap with held-out data and skip images already in the destination. Publish a new filtered native table for labeling; originals unchanged. Run on node_id=local: the destination journal belongs to this deployment. For retries keep batch_url as the original incoming table. Do not share an intake destination between deployments.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep_separate": {
          "type": "boolean",
          "default": false
        },
        "labeled": {
          "type": "boolean",
          "default": false
        },
        "node_id": {
          "type": "string",
          "const": "local",
          "default": "local"
        },
        "expected_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "table_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "dataset_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "destination_table": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "reference_table": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "batch_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "modality": {
          "enum": [
            "classification",
            "bounding_boxes",
            "instance_masks",
            "semantic_map"
          ]
        },
        "identity_column": {
          "type": "string",
          "maxLength": 200
        },
        "group_column": {
          "type": "string",
          "maxLength": 200
        },
        "heldout_tables": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "default": 10000
        },
        "project_name": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "table_url",
        "dataset_name",
        "modality"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "job": {
      "body": {
        "operation": "intake_prepare",
        "keep_separate": "{{keep_separate}}",
        "labeled": "{{labeled}}",
        "expected_classes": "{{expected_classes}}",
        "table_url": "{{table_url}}",
        "dataset_name": "{{dataset_name}}",
        "destination_table": "{{destination_table}}",
        "reference_table": "{{reference_table}}",
        "batch_url": "{{batch_url}}",
        "modality": "{{modality}}",
        "identity_column": "{{identity_column}}",
        "group_column": "{{group_column}}",
        "heldout_tables": "{{heldout_tables}}",
        "max_rows": "{{max_rows}}",
        "project_name": "{{project_name}}"
      },
      "outputs": [
        "table_url",
        "intake"
      ],
      "wait": true
    }
  },
  {
    "name": "intake_publish",
    "title": "Add reviewed data to a dataset",
    "description": "Validate native annotations and exact reference classes; preserve reference class IDs, deduplicate and publish an immutable dataset release. Existing validation/test tables are never changed. The deployment serializes concurrent batches and reuses completed receipts. Run on node_id=local: the destination journal belongs to this deployment. For retries keep batch_url as the original incoming table. Do not share an intake destination between deployments.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep_separate": {
          "type": "boolean",
          "default": false
        },
        "labeled": {
          "type": "boolean",
          "default": false
        },
        "node_id": {
          "type": "string",
          "const": "local",
          "default": "local"
        },
        "expected_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "table_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "dataset_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "destination_table": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "reference_table": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "batch_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "modality": {
          "enum": [
            "classification",
            "bounding_boxes",
            "instance_masks",
            "semantic_map"
          ]
        },
        "identity_column": {
          "type": "string",
          "maxLength": 200
        },
        "group_column": {
          "type": "string",
          "maxLength": 200
        },
        "heldout_tables": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "default": 10000
        },
        "project_name": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "table_url",
        "dataset_name",
        "modality"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "job": {
      "body": {
        "operation": "intake_publish",
        "keep_separate": "{{keep_separate}}",
        "labeled": "{{labeled}}",
        "expected_classes": "{{expected_classes}}",
        "table_url": "{{table_url}}",
        "dataset_name": "{{dataset_name}}",
        "destination_table": "{{destination_table}}",
        "reference_table": "{{reference_table}}",
        "batch_url": "{{batch_url}}",
        "modality": "{{modality}}",
        "identity_column": "{{identity_column}}",
        "group_column": "{{group_column}}",
        "heldout_tables": "{{heldout_tables}}",
        "max_rows": "{{max_rows}}",
        "project_name": "{{project_name}}"
      },
      "outputs": [
        "table_url",
        "intake"
      ],
      "wait": true
    }
  }
]
